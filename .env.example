# Copy to .env (repo root or demo/) and fill in your own values:
#   cp .env.example .env
# python -m fitcheck and make load it automatically; variables already set in your shell win.
# .env is gitignored. Never commit real keys.

# Anthropic: live answers, the live recruiter and the optional LLM judge.
# Leave empty to run everything in mock mode.
ANTHROPIC_API_KEY=

# LangSmith: dataset upload and experiments (make eval-dataset / make eval-experiment).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=fitcheck
# Optional: only for the EU region or a self-hosted instance.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Optional overrides
# FITCHECK_MODEL=claude-haiku-5-5          # model for both agents
# FITCHECK_JUDGE_MODEL=claude-sonnet-5-5   # model for the LLM judge (--judge)
# FITCHECK_LS_DATASET=fitcheck-fit-verdicts
